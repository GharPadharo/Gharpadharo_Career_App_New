# ==============================================================================
# GHARPADHARO CAREER PORTAL — LOCAL ENVIRONMENT TEMPLATE
# Copy this file to .env.local and fill in your development credentials.
# NEVER commit .env.local with real credentials or secrets to version control.
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (Auth.js / NextAuth v5)
# Note: Auth.js v5 natively uses AUTH_SECRET and AUTH_URL, but NEXTAUTH_SECRET and NEXTAUTH_URL are supported.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin Management:
# Runtime admin authorization is stored strictly in MongoDB User collection.
# To add or remove administrators, use the explicit CLI commands:
#   npm run add:admin -- admin@example.com
#   npm run remove:admin -- admin@example.com
# (ADMIN_SEED_EMAIL is completely optional and only used for backward-compatible first-time seeding)
# ADMIN_SEED_EMAIL=admin@gharpadharo.com

# MongoDB Atlas Connection
MONGODB_URI=
MONGODB_DB_NAME=gharpadharo_careers

# Cloudinary (Server-side Resume / Media Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Sheets Synchronization (Secondary Operations / Recruitment Pipeline)
# 1. Create a Google Cloud Project & enable the Google Sheets API.
# 2. Create a Service Account, generate a JSON key, and copy client_email & private_key below.
# 3. Create a Google Sheet and share it with Editor access to your GOOGLE_SERVICE_ACCOUNT_EMAIL.
# 4. Copy the Spreadsheet ID from the URL (https://docs.google.com/spreadsheets/d/<ID>/edit).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Optional: Target worksheet name (defaults to "Applications")
GOOGLE_SHEETS_TAB_NAME=Applications

